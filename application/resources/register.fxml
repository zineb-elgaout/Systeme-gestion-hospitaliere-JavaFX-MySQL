<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.RegisterController"
      prefHeight="720" prefWidth="980"
      styleClass="login-root">

    <!-- ══ PANNEAU GAUCHE ══════════════════════════════════ -->
    <VBox styleClass="login-left" alignment="CENTER"
          prefWidth="320" spacing="20">

        <Label text="🏥" styleClass="hospital-icon"/>
        <Label text="HôpitalGest" styleClass="app-name"/>
        <Label text="Espace Patient" styleClass="app-title"/>

        <Separator style="-fx-background-color:rgba(255,255,255,0.2);"/>

        <VBox spacing="18" style="-fx-padding:0 20px;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="①"
                       style="-fx-text-fill:#FAC775;-fx-font-size:20px;
                              -fx-font-weight:bold;"/>
                <VBox spacing="2">
                    <Label text="Remplissez le formulaire"
                           style="-fx-text-fill:white;-fx-font-weight:bold;
                                  -fx-font-size:13px;"/>
                    <Label text="Vos informations personnelles"
                           style="-fx-text-fill:#aed6f1;-fx-font-size:11px;"/>
                </VBox>
            </HBox>
            
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="②"
                       style="-fx-text-fill:#FAC775;-fx-font-size:20px;
                              -fx-font-weight:bold;"/>
                <VBox spacing="2">
                    <Label text="Créez votre compte"
                           style="-fx-text-fill:white;-fx-font-weight:bold;
                                  -fx-font-size:13px;"/>
                    <Label text="Accès immédiat après inscription"
                           style="-fx-text-fill:#aed6f1;-fx-font-size:11px;"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="③"
                       style="-fx-text-fill:#FAC775;-fx-font-size:20px;
                              -fx-font-weight:bold;"/>
                <VBox spacing="2">
                    <Label text="Connectez-vous"
                           style="-fx-text-fill:white;-fx-font-weight:bold;
                                  -fx-font-size:13px;"/>
                    <Label text="Gérez vos rendez-vous et dossier"
                           style="-fx-text-fill:#aed6f1;-fx-font-size:11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <!-- ══ PANNEAU DROIT ═══════════════════════════════════ -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background:transparent;
                       -fx-background-color:#f0f4f8;
                       -fx-padding:0;">
        <VBox alignment="CENTER" style="-fx-padding:28px 40px;
                                        -fx-background-color:#f0f4f8;">
            <VBox fx:id="registerCard" styleClass="login-card"
                  alignment="TOP_LEFT" spacing="0"
                  maxWidth="460" minWidth="360">

                <Label text="Créer un compte Patient"
                       styleClass="card-title"/>
                <Label text="* Champs obligatoires"
                       styleClass="card-subtitle"/>

                <Region prefHeight="16"/>
                <!-- Messages retour -->
                <Label fx:id="errorLabel"   styleClass="error-label" managed="false"
                       visible="false" wrapText="true" maxWidth="Infinity"/>
                <Label fx:id="successLabel" styleClass="success-label" managed="false"
                       visible="false" wrapText="true" maxWidth="Infinity"/>

                <!-- Nom & Prénom -->
                <HBox spacing="12">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Nom *" styleClass="field-label"/>
                        <TextField fx:id="nomField"
                                   promptText="El Amrani"
                                   styleClass="input-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Prénom *" styleClass="field-label"/>
                        <TextField fx:id="prenomField"
                                   promptText="Mohammed"
                                   styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Region prefHeight="10"/>

                <!-- Email + statut temps réel -->
                <Label text="Adresse e-mail *" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="exemple@email.com"
                           styleClass="input-field"/>
                <Label fx:id="emailStatusLabel"
                       visible="false"
                       style="-fx-font-size:11px;-fx-padding:2px 0 0 2px;"/>

                <Region prefHeight="10"/>

                <!-- Téléphone & Date naissance -->
                <HBox spacing="12">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Téléphone" styleClass="field-label"/>
                        <TextField fx:id="telephoneField"
                                   promptText="06XXXXXXXX"
                                   styleClass="input-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Date de naissance"
                               styleClass="field-label"/>
                        <TextField fx:id="dateNaissanceField"
                                   promptText="AAAA-MM-JJ"
                                   styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Region prefHeight="10"/>

                <!-- Adresse -->
                <Label text="Adresse" styleClass="field-label"/>
                <TextField fx:id="adresseField"
                           promptText="Rue, Ville"
                           styleClass="input-field"/>

                <Region prefHeight="10"/>

                <!-- Groupe sanguin & Allergies -->
                <HBox spacing="12">
                    <VBox spacing="3">
                        <Label text="Groupe sanguin"
                               styleClass="field-label"/>
                        <ComboBox fx:id="groupeSanguinCombo"
                                  styleClass="input-field"
                                  prefWidth="130"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Allergies connues"
                               styleClass="field-label"/>
                        <TextField fx:id="allergiesField"
                                   promptText="Pénicilline, Aspirine..."
                                   styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Region prefHeight="12"/>

                <!-- Séparateur sécurité -->
                <HBox alignment="CENTER" spacing="10">
                    <Separator HBox.hgrow="ALWAYS"/>
                    <Label text="🔒  Sécurité"
                           style="-fx-font-size:11px;
                                  -fx-text-fill:#7f8c8d;"/>
                    <Separator HBox.hgrow="ALWAYS"/>
                </HBox>

                <Region prefHeight="10"/>

                <!-- Mots de passe -->
                <HBox spacing="12">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Mot de passe *"
                               styleClass="field-label"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Min. 6 caractères"
                                       styleClass="input-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Confirmer *"
                               styleClass="field-label"/>
                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Répéter"
                                       styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Region prefHeight="12"/>

               

                <!-- Bouton inscription -->
                <Button fx:id="registerButton"
                        text="Créer mon compte Patient"
                        styleClass="btn-primary"
                        onAction="#handleRegister"
                        maxWidth="Infinity"/>

                <Region prefHeight="12"/>

                <!-- Lien retour login -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Déjà un compte ?"
                           style="-fx-font-size:12px;
                                  -fx-text-fill:#7f8c8d;"/>
                    <Label text="Se connecter"
                           styleClass="link-label"
                           onMouseClicked="#handleBackToLogin"/>
                </HBox>

                <Region prefHeight="8"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>