<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.LoginController"
      prefHeight="600" prefWidth="920"
      styleClass="login-root">

    <!-- ══ PANNEAU GAUCHE ══════════════════════════════════ -->
    <VBox styleClass="login-left" alignment="CENTER"
          prefWidth="420" spacing="18">

        <Label text="🏥" styleClass="hospital-icon"/>
        <Label text="HôpitalGest" styleClass="app-name"/>
        <Label text="Système de Gestion Hospitalière"
               styleClass="app-title" wrapText="true"/>
        <Label styleClass="divider-line"/>
        <Label text="Gérez vos patients, rendez-vous,&#10;pharmacie et facturation."
               styleClass="app-subtitle" wrapText="true"
               textAlignment="CENTER"/>
    </VBox>

    <!-- ══ PANNEAU DROIT ═══════════════════════════════════ -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
          styleClass="login-right">

        <VBox fx:id="loginCard" styleClass="login-card"
              alignment="TOP_LEFT"
              maxWidth="380" minWidth="320"
              spacing="0">

            <!-- ══ TITRE ════════════════════════════════════ -->
            <Label text="Connexion" styleClass="card-title"/>
            <Label text="Entrez vos identifiants pour accéder à votre espace"
                   styleClass="card-subtitle" wrapText="true"/>

            <Region prefHeight="20"/>

            <!-- ══ LABEL SUCCÈS (caché par défaut) ══════════ -->
            <Label fx:id="successLabel"
                   styleClass="success-label"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <Region fx:id="successSpacer"
                    prefHeight="12"
                    visible="false"
                    managed="false"/>

            <!-- ══ LABEL ERREUR (caché par défaut) ══════════ -->
            <Label fx:id="errorLabel"
                   styleClass="error-label"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <Region fx:id="errorSpacer"
                    prefHeight="12"
                    visible="false"
                    managed="false"/>

            <!-- ══ CHAMP EMAIL ═══════════════════════════════ -->
            <Label text="Adresse e-mail" styleClass="field-label"/>
            <TextField fx:id="emailField"
                       promptText="exemple@hopital.ma"
                       styleClass="input-field"/>

            <Region prefHeight="12"/>

            <!-- ══ CHAMP MOT DE PASSE ════════════════════════ -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Mot de passe" styleClass="field-label"
                       HBox.hgrow="ALWAYS"/>
                <Label fx:id="togglePasswordLabel"
                       text="👁 Afficher"
                       styleClass="toggle-pwd-label"
                       onMouseClicked="#handleTogglePassword"/>
            </HBox>

            <!-- StackPane : PasswordField + TextField superposés -->
            <StackPane>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               styleClass="input-field"/>
                <TextField fx:id="passwordVisible"
                           promptText="••••••••"
                           styleClass="input-field"
                           visible="false"
                           managed="false"/>
            </StackPane>

            <Region prefHeight="12"/>

            <!-- ══ BOUTON CONNEXION ══════════════════════════ -->
            <Button fx:id="loginButton"
                    text="Se connecter"
                    styleClass="btn-primary"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    defaultButton="true"/>

            <Region prefHeight="16"/>

            <!-- ══ SÉPARATEUR OU ═════════════════════════════ -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OU"
                       style="-fx-font-size:11px;
                              -fx-text-fill:#bdc3c7;
                              -fx-font-weight:bold;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="16"/>

            <!-- ══ LIEN REGISTER ═════════════════════════════ -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Vous êtes un nouveau patient ?"
                       style="-fx-font-size:12px;
                              -fx-text-fill:#7f8c8d;"
                       maxWidth="Infinity"/>
                <Button text="Créer un compte Patient"
                        styleClass="btn-register"
                        onAction="#handleGoToRegister"
                        maxWidth="Infinity"/>
            </VBox>

            <Region prefHeight="16"/>

            <!-- ══ AIDE ══════════════════════════════════════ -->
            <Label text="En cas de problème, contactez l'administrateur."
                   styleClass="help-text"
                   wrapText="true"
                   maxWidth="Infinity"/>

        </VBox>
    </VBox>
</HBox>